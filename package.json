{
  "name": "leanstartup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "format": "prettier --write src/",
    "alova-gen": "alova-gen",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:mock": "playwright test --project=chromium-mock tests/e2e/pages/*-mock.spec.ts tests/e2e/flows/*-mock.spec.ts",
    "test:mock:ui": "playwright test --project=chromium-mock --ui tests/e2e/pages/*-mock.spec.ts tests/e2e/flows/*-mock.spec.ts",
    "test:all": "playwright test --project=chromium",
    "sync:content": "node scripts/sync-content/index.js",
    "sync:content:dev": "NODE_ENV=development node scripts/sync-content/index.js",
    "sync:test": "node scripts/sync-content/tests/crawler.test.js"
  },
